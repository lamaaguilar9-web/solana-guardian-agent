# ==============================================================================
# Solana DeFi Guardian Agent - Environment Configuration
# ==============================================================================

# 1. Ingestion & RPC Nodes
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_GEYSER_GRPC_URL=grpc://yellowstone-mainnet.helius.xyz:443
GEYSER_AUTH_TOKEN=your_helius_or_triton_token_here

# 2. Jito MEV Execution
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_KEYPAIR_PATH=/secrets/jito-keypair.json
MAX_PRIORITY_FEE_LAMPORTS=2000000000
JITO_TIP_P99_LAMPORTS=5000000
EMERGENCY_FIXED_TIP_LAMPORTS=1000000000
OUTFLOW_EPSILON_INVARIANT=0.05

# 3. Security & Cloud KMS Key Management (RBAC: guardian_pause only)
KMS_PROVIDER=google_kms # aws_kms | google_kms | local_simulated
KMS_KEY_ID=projects/sentinel-lab/locations/global/keyRings/guardian/cryptoKeys/pause-signer
SQUADS_MULTISIG_PROGRAM_ID=SQDS4ep65T869zMMBKyuUq6aD6EgTu8psMjkvj52pCf
SQUADS_VAULT_ADDRESS=SquadsRecoveryVaultAddress11111111111111111

# 4. Multi-Oracle Settings (Pyth & Switchboard)
PYTH_PRICE_SERVICE_URL=https://hermes.pyth.network
ORACLE_MAX_DIVERGENCE_PCT=3.5
ORACLE_STALENESS_SECONDS=15

# 5. Risk & Outflow Velocity
OUTFLOW_VELOCITY_WINDOW_MINUTES=5
MAX_OUTFLOW_PERCENT_THRESHOLD=15.0

# 6. Webhook Incident Dispatchers
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/dummy/alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAGERDUTY_ROUTING_KEY=
